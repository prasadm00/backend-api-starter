  "scripts": {
    "test": "tsx --test src/tests/*.test.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js && esbuild src/workers/email.worker.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/workers/email.worker.js",
    "start": "node dist/server.js",
    "migrate": "prisma migrate dev",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test src/tests/*.test.ts",
    "worker": "tsx src/workers/email.worker.ts",
    "worker:prod": "node dist/workers/email.worker.js",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "verify:source": "node scripts/verify-source.mjs"
  },
  "keywords": [],
  "author": "",
